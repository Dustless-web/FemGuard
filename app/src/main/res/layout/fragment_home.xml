<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 1. Top Status Bar (Now Indigo) -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="24dp"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Icon with Indigo Tint -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home"
            app:tint="@color/brand_primary"
            android:background="#E8EAF6"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian Active"
                android:textStyle="bold"
                android:textColor="@color/brand_dark"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Secure and Ready"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 2. The Glowing SOS Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/actionGrid"
        android:layout_below="@id/header"
        android:gravity="center">

        <!-- Outer Ring -->
        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_sos_gradient"
            android:alpha="0.1"
            android:layout_centerInParent="true"/>

        <!-- Inner Ring -->
        <View
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@drawable/bg_sos_gradient"
            android:alpha="0.3"
            android:layout_centerInParent="true"/>

        <androidx.cardview.widget.CardView
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:cardCornerRadius="100dp"
            app:cardElevation="20dp"
            android:layout_centerInParent="true"
            app:cardBackgroundColor="@android:color/transparent">

            <Button
                android:id="@+id/btnSOS"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_sos_gradient"
                android:text="SOS"
                android:textSize="48sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/white"
                android:stateListAnimator="@null"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP AND HOLD FOR HELP"
            android:layout_below="@id/header"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="260dp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.15"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- 3. Bottom Action Grid -->
    <LinearLayout
        android:id="@+id/actionGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="20dp"
        android:weightSum="2"
        android:clipToPadding="false">

        <!-- Fake Call Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <Button
                android:id="@+id/btnFakeCall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:text="Fake Call"
                android:drawableTop="@drawable/ic_contacts"
                android:drawableTint="@color/brand_secondary"
                android:paddingTop="30dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>
        </androidx.cardview.widget.CardView>

        <!-- Live Map Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <Button
                android:id="@+id/btnMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:text="Live Map"
                android:drawableTop="@drawable/ic_home"
                android:drawableTint="@color/brand_primary"
                android:paddingTop="30dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</RelativeLayout>