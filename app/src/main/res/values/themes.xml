<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Guardian" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (Indigo) -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status Bar Color -->
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Backgrounds -->
        <item name="android:colorBackground">@color/bg_main</item>
    </style>
</resources>